# 로컬 백엔드 대신 운영 백엔드(Swagger: https://valuegg.shop/swagger-ui/index.html)로 붙으려면
# 아래 두 값을 https://valuegg.shop 으로 바꾸면 된다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/api/v1/login/kakao
# 백엔드 KAKAO_REDIRECT_URI 도 위 값과 같아야 합니다. (카카오 콘솔에 등록된 Redirect URI)
# production: https://valuego-beta.vercel.app/api/v1/login/kakao
# development에서 MSW를 쓰려면 true (handlers 추가 후 layout에 MswProvider 연결)
NEXT_PUBLIC_MSW=false
